# Скопируй в .env (локально) или задай как переменные окружения на хостинге.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=my-shop.onrender.com
CSRF_TRUSTED_ORIGINS=https://my-shop.onrender.com
SITE_URL=https://my-shop.onrender.com

BOT_TOKEN=
CHAT_ID=

# Прод: одна строка подключения (Neon/Supabase). Локально можно вместо неё задать DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT.
DATABASE_URL=

# Медиа (S3-совместимое: Cloudflare R2 / Supabase Storage). Обязательно при DEBUG=False; при DEBUG=True можно пусто — файлы на локальном диске.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Свой путь к админке (со слэшем на конце), напр. ADMIN_URL=panel-x7k2/. По умолчанию admin/
ADMIN_URL=
